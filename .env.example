# Database
DATABASE_URL=postgresql://sparkstack:password@localhost:5432/sparkstack
POSTGRES_DB=sparkstack
POSTGRES_USER=sparkstack
POSTGRES_PASSWORD=password

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sparkstack
MINIO_USE_SSL=false

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional — get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Configuration ---
# Set AI_PROVIDER to force a specific provider: "anthropic" | "openrouter" | "agent-sdk"
# If not set, auto-detects from available keys (agent-sdk if USE_AGENT_SDK=true)
# AI_PROVIDER=

# Option 1: Anthropic API (direct)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option 2: OpenRouter (access 100+ models via one API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Option 3: Claude Agent SDK (Claude Code tools — read/write/edit/bash)
# Requires ANTHROPIC_API_KEY + USE_AGENT_SDK=true
USE_AGENT_SDK=false
AGENT_MODEL=claude-sonnet-4-6
