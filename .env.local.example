# Minimal host-native local development config.
#
# Do not set DATABASE_URL here. When DATABASE_URL is unset, SparkBench uses
# projects/<slug>/ on disk and skips PostgreSQL, MinIO, and auth.
SPARKBENCH_LOCAL_DEV=1

# Required only for Sparky chat.
ANTHROPIC_API_KEY=

# Optional. Enables DeepPCB routing.
DEEPPCB_API_KEY=

# Optional. Leave unset unless PlatformIO lives outside the default location.
# PLATFORMIO_CORE_DIR=/Users/you/.platformio

NEXT_PUBLIC_APP_URL=http://localhost:3000
